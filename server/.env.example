DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
PORT=4000

# Groq API - sesli giriş (Whisper) + metin ayrıştırma için
GROQ_API_KEY=
# opsiyonel, Groq model kataloğu değişirse override et:
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Giriş şifresi (uygulamaya girmek için gerekli)
APP_PASSWORD=
JWT_SECRET=
