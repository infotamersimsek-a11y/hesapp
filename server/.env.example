DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
PORT=4000

# Groq API - sesli giriş (Whisper) + metin ayrıştırma + dekont/fiş okuma (vision) için
GROQ_API_KEY=
# opsiyonel, Groq model kataloğu değişirse override et:
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Giriş şifreleri (her biri farklı kullanıcıya ve açılışta gösterilecek dükkana karşılık gelir)
APP_PASSWORD=
APP_PASSWORD_2=
JWT_SECRET=

# son 3 günden eski tarihe kayıt eklemek için yönetici şifresi
ADMIN_PASSWORD=
